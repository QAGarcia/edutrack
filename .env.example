# ───────────── EduTrack ─────────────
NODE_ENV=development
PORT=3000

# Banco de dados (Postgres local, Docker ou Supabase)
# Supabase: botão "Connect" → "Session pooler" (URI) e DATABASE_SSL=true
DATABASE_URL=postgresql://edutrack:edutrack@localhost:5432/edutrack
DATABASE_SSL=false

# Autenticação (troque o segredo fora do ambiente local; mínimo 16 caracteres)
JWT_SECRET=edutrack-dev-secret-change-me
JWT_EXPIRES_IN=2h
# Tentativas de login por minuto, por IP (em produção use algo como 5–10)
LOGIN_RATE_LIMIT=30

# Origem do frontend em desenvolvimento (Vite)
CORS_ORIGIN=http://localhost:5173

# Habilita POST /api/testing/reset — NUNCA em produção
ENABLE_TEST_ROUTES=true
